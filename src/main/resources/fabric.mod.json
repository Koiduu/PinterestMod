{
  "schemaVersion": 1,
  "id": "pinspo",
  "version": "${version}",
  "name": "PinSpo",
  "description": "In-game Pinterest references for builders: pin images on screen or onto a wall, plant live camera views, and match any pixel to the closest block.",
  "authors": [
    "Koiduu"
  ],
  "contact": {
    "sources": "https://github.com/Koiduu/PinterestMod"
  },
  "license": "MIT",
  "icon": "assets/pinspo/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.koiduu.pinspo.PinSpoClient"
    ]
  },
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*"
  },
  "mixins": [
    "pinspo.mixins.json"
  ]
}
